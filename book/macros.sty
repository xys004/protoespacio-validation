% El paquete `book` no define `abstract`; los borradores (de la clase `article`)
% lo usan al inicio de capitulos. Lo reimplementamos como bloque destacado.
\providecommand{\abstractname}{Resumen}
\newenvironment{abstract}{%
  \par\medskip\noindent
  \begin{quote}\small\itshape
  \textbf{\abstractname.\ }\ignorespaces
}{%
  \end{quote}\par\medskip
}

